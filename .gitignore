# Ignore all files and directories in root
/*

# Explicitly whitelist BTP_CNG_Data and git configuration
!/BTP_CNG_Data/
!/.gitignore
!/README.md

# Research acceptance contract and durable agent instructions
!/AGENTS.md
!/research_workflow/
/research_workflow/*
!/research_workflow/acceptance_2026-11-09/

# Ignore legacy script in BTP_CNG_Data
BTP_CNG_Data/scripts/process_global_benchmarks.py

# Ignore Python caches & environment files anywhere
__pycache__/
*.py[cod]
*$py.class
.env
.venv
.vscode/
.idea/
.DS_Store
Thumbs.db

# Private evidence delivery metadata and separately retained raw acquisitions
BTP_CNG_Data/metadata/evidence_archive_library_links.csv
BTP_CNG_Data/raw/*/SRC-*
BTP_CNG_Data/documents/source_text/
BTP_CNG_Data/documents/ocr_text/
