# Ignore all files and directories in root
/*

# Explicitly whitelist BTP_CNG_Data and git configuration
!/BTP_CNG_Data/
!/.gitignore
!/README.md

# Ignore legacy script in BTP_CNG_Data
BTP_CNG_Data/scripts/process_global_benchmarks.py

# Ignore Python caches & environment files anywhere
__pycache__/
*.py[cod]
*$py.class
.env
.venv
.vscode/
.idea/
.DS_Store
Thumbs.db

# Large new evidence is preserved in checksum-tracked evidence bundles.
BTP_CNG_Data/raw/recovery/
BTP_CNG_Data/documents/extracted/
BTP_CNG_Data/documents/ocr/
BTP_CNG_Data/raw/manual/
__pycache__/

# Equivalent large CSV can be regenerated from the committed Parquet.
BTP_CNG_Data/structured/source_native/document_table_rows.csv
